@model RPA_TOOL.Models.uploadfileModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    

    <style>
        :root {
    --color-primary:#3B0470;
    --color-hover:#A03333;
    --color-OK:#6B4;
    --color-NG:#F00;
    --color_btnBackground:#EFEFEF;
}
  body{
      margin:0 10vw;
  }
  html{
      font-size:2rem;
  }
  .title{
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:2:rem;
      color:white;
      background-color:var(--color-primary);
      height:4vw;
  }
.tool{
    width:100%;
    box-sizing: border-box;
    border:1px solid var(--color-primary);
    display:flex;
    align-content:center;
    margin:2px 0 0 0;
}
.tool-left
{
    width:50%;
    border-width:0 1px 0 0;
    border-style:solid;
    border-color:var(--color-primary);
}
.tool-right
{
    width:50%;
}
.tool-left-upload{
    width:100%;
    height:20vw;
}
.tool-right-upload{
    width:100%;
}

.tool-right-upload > .tool-title{
    border-width:0px 0px 0px 1px;
    border-style:solid;
    border-color:#fff;
}
.tool-title{
    box-sizing: border-box;
    color:#fff;
    font-size:0.7rem;
    height:2vw;
    width:100%;
    display:block;
    align-content:center;
    justify-content:flex-start;
    background-color:var(--color-primary);
    margin:0;
    padding:0 0 0 1vw;
}
.upload-form{
    padding:0 0 0 1vw;
}
.upload-form > .upload-Lbl:hover{
    color:var(--color-primary);
    
}
.upload-form > .upload-txt{
    width:75%;
    height:1vw;
    font-size:1vw;
}
.upload-form > .upload-txt1{
    font-size:0.5rem;
    
}
.upload-form > .upload-btns{
    display:flex;
    align-content:center;
    margin:1vw 1vw;
}
.upload-form > .upload-Lbl{
    font-size:0.7rem;
    margin-left:1px;
    border:1px solid black;
    font-size:0.4rem;
    background-color:var(--color_btnBackground);
}
.upload-btns > .upload-btn{
    font-size:0.5rem;
    margin-left:1.8vw;
    padding:0.1vw 0.2vw;
}

.uploadResult > .txt{
    font-size:1rem;
    margin-bottom:0;
}
.uploadResult > .txtResultNG{
    font-size:0.7rem;
    color:var(--color-NG);
    margin-left:1vw;
    margin-top:0;
}
.uploadResult > .txtResultOK{
    font-size:0.7rem;
    color:var(--color-OK);
    margin-left:1vw;
    margin-top:0;
}


.tool-description > .txt{
    font-size:0.5rem;
    margin:0 0 0 1vw;
    margin-left:1vw;
}
.uploadResult > .txt{
    font-size:0.7rem;
    margin-left:1vw;
}



.tool-left-download{
    width:100%;
}

.download-table{
    border-collapse: collapse;
    font-size:0.5rem;
    border:1px solid black;
    margin:1vw 1vw 2vw 1vw;
    width:95%;
    position:relative;
}

.download-table .table-td-file{
    padding-left:0.5vw;
}




.download-table .table-h-down,.download-table .table-h-up{
    width:5vw;
}

    </style>
</head>
<body>
    <div class="title">服务器文件上传</div>
    <div class="tool">
        <div class="tool-left">
            <div class="tool-left-upload">
                <p class="tool-title">文件上传</p>
                <div class="tool-body">
                    <form class="upload-form" action="@Url.Action("transFileServe")" method="post" enctype="multipart/form-data">
                        <input type="file" id="uploadFileServe" name="uploadFile" style="opacity:0;position:absolute;width:0;height:0;">
                        <label class="upload-txt1">文件:</label>
                        <input class="upload-txt" id="upload-txt-serve" type="text" name="fileNmae" />
                        <label for="uploadFileServe" class="upload-Lbl">...</label>
                        <div class="upload-btns">
                            <input class="upload-btn" type="submit" value="上传" />
                        </div>
                    </form>
                </div>
            </div>
            <div class="tool-left-download">
                <p class="tool-title">文件列表</p>
                <div class="tool-body">
                    <table border="1" class="download-table">
                        <thead>
                            <tr>
                                <th class="table-h-file">文件</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                string folder = Server.MapPath("~/UploadFiles/ServeFile");
                                string[] fileNames = Directory.Exists(folder) ? Directory.GetFiles(folder).Select(Path.GetFileName).ToArray() : new string[0];
                                if (fileNames.Length == 0)
                                {
                                }
                                else
                                {
                                    foreach (string path in fileNames)
                                    {
                                        <tr>
                                            <td class="table-td-file">@path</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="tool-right">
            <div class="tool-right-upload">
                <p class="tool-title">结果</p>
                <div class="tool-body">
                    <div class="tool-description">
                        <p class="txt">内容：文件上传</p>
                    </div>
                    <div class="uploadResult">
                        @{
                            if (Model.flag == "NG")
                            {
                                <p class="txt">结果:</p>
                                <p class="txtResultNG">@Model.msg</p>
                            }
                            else if (Model.flag == "OK")
                            {
                                <p class="txt">结果:</p>
                                <p class="txtResultOK">@Model.msg</p>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
    const fileInput = document.getElementById('uploadFileServe');
    const nameSpan = document.getElementById('upload-txt-serve');
    fileInput.addEventListener('change', function () {
        if (this.files.length > 0) {
            nameSpan.value = this.files[0].name;
        } else {
            nameSpan.innerText = "未选择文件";
        }
    })
</script>

</html>
