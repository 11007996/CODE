<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		autoReload="true"
		internalLogLevel="Warn"
		internalLogFile="Logs/internal-nlog.txt">
	<targets async="true">
		<target name="File"
				xsi:type="File"
				fileName="Logs/${shortdate}.log"
				archiveAboveSize="4096000"
				archiveNumbering="Sequence"
				maxArchiveFiles="0"
				maxArchiveDays="60"
				layout="${time}|${callsite:includeNamespace=false}(${callsite-linenumber})|${level}|${message} ${exception}" />
		<target name="Console" xsi:type="ColoredConsole" layout="${time}|${callsite:includeNamespace=false}(${callsite-linenumber})|${level}|${message} ${exception}" />
		<target name="SystemConsole" xsi:type="ColoredConsole" layout="${time}|${level}|${message} ${exception}" />
	</targets>
	<rules>
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="SystemConsole,File" final="true" />
		<logger name="Microsoft.*" minlevel="Trace" maxlevel="Info" final="true" />
		<logger name="*" minlevel="Debug" writeTo="Console,File" />
	</rules>
</nlog>