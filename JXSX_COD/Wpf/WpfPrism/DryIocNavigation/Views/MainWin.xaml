<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DryIocNavigation.ViewModels"
        xmlns:p="http://prismlibrary.com/"
        xmlns:mylib="clr‑namespace:UserModel;assembly=UserModel"
        xmlns:UserModel="clr-namespace:UserModel;assembly=UserModel" xmlns:WpfLibrary="clr-namespace:WpfLibrary;assembly=WpfLibrary" x:Class="DryIocNavigation.ViewModels.MainWin"
        mc:Ignorable="d"
        Title="MainWin" Height="650" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="page1" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding BtnCommand}" CommandParameter="NpageA"/>
            <!--<TextBlock Text="{Binding TestText}" FontSize="50" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left"></TextBlock>-->
            <Button Content="page2" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding BtnCommand}" CommandParameter="NpageB"/>
            <Button Content="page3" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding regionPage}"/>
            <Button Content="pageDll" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="0" HorizontalAlignment="left" VerticalAlignment="Center" Command="{Binding LoadModel}"/>
        </Grid>
        <!--<TabControl Grid.Row="1" p:RegionManager.RegionName="pageNavigate"></TabControl>-->
        <ContentControl Grid.Row="1" p:RegionManager.RegionName="pageNavigate"/>
        <ContentControl Grid.Row="2" p:RegionManager.RegionName="pageNavigate1"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="上一页" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Command="{Binding goBack}"/>
            <Button Content="下一页" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Command="{Binding goAhead}"/>
            <Button Content="复合命令" Width="100" Height="50" FontSize="20" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Command="{Binding composite}"/>
        </Grid>
    </Grid>
</Window>