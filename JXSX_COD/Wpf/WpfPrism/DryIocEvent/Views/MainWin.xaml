<Window x:Class="DryIocEvent.Views.MainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DryIocEvent.Views"
        xmlns:p="http://prismlibrary.com/"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWin" Height="450" Width="500">
    <Grid x:Name="gridRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBox x:Name="txt" Grid.Row="0" Grid.Column="0" Width="80" Height="30" Text="{Binding TextBox ,UpdateSourceTrigger=PropertyChanged}" />
        
        <Button Content="按我" Grid.Row="0" Grid.Column="1" Width="80" Height="50">
            <!--自定义命令绑定-->
            <i:Interaction.Triggers>
                <!-- 监听鼠标按下事件 MouseDown -->
                <i:EventTrigger EventName="MouseEnter">
                    <!-- 绑定VM中的命令，可传参数 -->
                    <i:InvokeCommandAction 
                Command="{Binding ButtonMouse}"
                CommandParameter="{Binding TextBox}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>

        <Button Content="弹窗" Grid.Row="0" Grid.Column="2" Width="80" Height="50" Command="{Binding ButtonEvent}"></Button>
        <Button x:Name="eventButton" Content="直接事件" Grid.Row="1" Grid.Column="0" Width="80" Height="50"></Button>
        <Button x:Name="eventButton1" Content="点击事件1" Grid.Row="1" Grid.Column="1" Width="80" Height="50" Click="eventButton1_Click"></Button>
    </Grid>
</Window>
